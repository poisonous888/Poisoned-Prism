{
    "model": {
        "type": "range_dispatch",
        "property": "cooldown",
        "entries": [
            {
                "threshold": 0.001,
                "model": {
                    "type": "condition", "property": "selected",
                    "on_true": {
                        "type": "condition", "property": "keybind_down", "keybind": "key.use",
                        "on_true": {"type": "model", "model": "psnprsm:sword/gold"},
                        "on_false": {"type": "model", "model": "item/golden_sword"}
                    },
                    "on_false": {"type": "model", "model": "item/golden_sword"}
                }
            }
        ],
        "fallback": {
            "type": "condition", "property": "selected",
            "on_true": {
                "type": "condition", "property": "keybind_down", "keybind": "key.use",
                "on_true": {"type": "model", "model": "psnprsm:sword/diamond"},
                "on_false": {"type": "model", "model": "item/diamond_sword"}
            },
            "on_false": {"type": "model", "model": "item/diamond_sword"}
        }
    }
}